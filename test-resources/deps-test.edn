{:deps    {org.clojure/clojure                                {:mvn/version "1.12.4"}
           io.netty/netty-transport-native-epoll$linux-x86_64 {:mvn/version "4.1.130.Final"}
           io.github.tonsky/clj-reload                        {:mvn/version "1.0.0"}}

 :aliases {:build {:deps       {org.clojure/clojure           {:mvn/version "1.12.4"}
                                io.github.clojure/tools.build {:mvn/version "0.10.5"}}
                   :ns-default build}
           :test  {:extra-paths ["test" "test-resources"]
                   :extra-deps  {org.clojure/clojure {:mvn/version "1.12.4"}
                                 io.github.cognitect-labs/test-runner
                                 {:git/tag "v0.5.1" :git/sha "dfb30dd"}}

                   :jvm-opts    ["-Dclj-commons.ansi.enabled=true"]
                   :exec-fn     cognitect.test-runner.api/test}}}